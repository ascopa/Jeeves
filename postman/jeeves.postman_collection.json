              ]
            },
            "description": "402 payment_declined. The hold stays, so the user can try another card with a new key.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": \"{{ticketId}}\",\n  \"paymentToken\": \"{{paymentToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 402', () => pm.response.to.have.status(402));",
                  "pm.test('payment_declined', () => pm.expect(pm.response.json().error).to.eql('payment_declined'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tokenize a card that approves",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{cardProviderUrl}}/tokens",
              "host": [
                "{{cardProviderUrl}}"
              ],
              "path": [
                "tokens"
              ]
            },
            "description": "Sends the card to the card provider, not to Jeeves, and saves the returned {{paymentToken}}. 4242424242424242 approves.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"4242424242424242\",\n  \"expMonth\": 12,\n  \"expYear\": 2030,\n  \"cvv\": \"123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('paymentToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Check out with another card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "checkout"
              ]
            },
            "description": "The same seat, a new card and a new key: sold.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": \"{{ticketId}}\",\n  \"paymentToken\": \"{{paymentToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sold', () => pm.expect(pm.response.json().status).to.eql('sold'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
