              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has a position', () => pm.expect(pm.response.json().position).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check the queue status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/queue/{{eventId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "queue",
                "{{eventId}}",
                "status"
              ]
            },
            "description": "Position, people ahead and an estimated wait, until the user is admitted. Then it saves {{admissionToken}}, valid for 15 minutes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const wait = Number(pm.collectionVariables.get('retryAfter') || 0);",
                  "pm.collectionVariables.unset('retryAfter');",
                  "if (wait > 0) { setTimeout(() => {}, wait * 1000); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "if (body.status === 'admitted') {",
                  "  pm.collectionVariables.set('admissionToken', body.admissionToken);",
                  "  pm.collectionVariables.unset('polls');",
                  "} else if (body.status === 'waiting') {",
                  "  const polls = Number(pm.collectionVariables.get('polls') || 0) + 1;",
                  "  pm.collectionVariables.set('polls', polls);",
                  "  pm.test('admitted within 30 polls', () => pm.expect(polls).to.be.below(30));",
                  "  if (polls < 30) {",
                  "    pm.collectionVariables.set('retryAfter', Number(pm.response.headers.get('Retry-After') || 1));",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "See the seats with admission",
